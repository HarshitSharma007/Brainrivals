# Native Android and separate hosting need a reachable HTTPS Socket.IO server.
# Browser development uses Vite's local proxy when this is empty.
VITE_SERVER_URL=
PORT=3001
# Comma-separated allowed browser origins, set explicitly before internet hosting.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost
# Render sets RENDER_EXTERNAL_URL itself. PUBLIC_ORIGIN is optional for a custom web domain.
# Server variables must be supplied by the host/process, not just this file.
PUBLIC_ORIGIN=
SERVE_WEB=0
MAX_ROOMS=100